# ============================================================================
#  Crypto AI Trader - نمونه فایل متغیرهای محیطی
#  این فایل را به نام «.env» کپی کنید و مقادیر را تکمیل نمایید.
#  هشدار: فایل .env هرگز نباید در Git ثبت شود (در .gitignore قرار دارد).
#  نکته امنیتی: کلیدهای API ترجیحاً از داخل خود نرم‌افزار (بخش تنظیمات)
#  وارد شوند تا در Windows Credential Manager / DPAPI ذخیره گردند.
# ============================================================================

# --- General / عمومی ---
CAT_APP_ENV=production           # production | development
CAT_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
CAT_LANGUAGE=fa                  # fa | en
CAT_THEME=dark                   # dark | light | system

# --- Database / پایگاه داده ---
# اگر خالی بماند، مسیر پیش‌فرض داخل پوشه data استفاده می‌شود
CAT_DATABASE_URL=

# --- Exchange (LBank) / صرافی ---
CAT_LBANK_REST_URL=https://api.lbkex.com
CAT_LBANK_WS_URL=wss://www.lbkex.net/ws/V2/
# کلیدهای زیر فقط برای توسعه/تست هستند؛ در حالت عادی خالی بگذارید.
CAT_LBANK_API_KEY=
CAT_LBANK_API_SECRET=

# --- AI Providers / ارائه‌دهندگان هوش مصنوعی ---
# Ollama (مدل محلی و رایگان)
CAT_OLLAMA_BASE_URL=http://localhost:11434
CAT_OLLAMA_MODEL=llama3.1

# OpenAI-Compatible (هر سرویسی که با فرمت OpenAI سازگار باشد)
CAT_OPENAI_BASE_URL=https://api.openai.com/v1
CAT_OPENAI_API_KEY=
CAT_OPENAI_MODEL=gpt-4o-mini
